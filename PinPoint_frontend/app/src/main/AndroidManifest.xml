        <activity
            android:name=".ResetPasswordNewActivity"
            android:exported="false" />

        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- Halaman Admin -->
        <activity
            android:name=".admin.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".admin.VerifikasiLaporanActivity"
            android:exported="false" />


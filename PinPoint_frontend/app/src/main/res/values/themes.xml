<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PinPoint" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">#2563EB</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DBEAFE</item>
        <item name="colorOnPrimaryContainer">#1E40AF</item>
        
        <item name="colorSecondary">#3B82F6</item>
        <item name="colorSecondaryContainer">#EFF6FF</item>
        
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.PinPoint" parent="Base.Theme.PinPoint" />

    <style name="cr12">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Style untuk 6 Kotak Input OTP -->
    <style name="OtpInputStyle">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:textColor">#0B1C30</item>
        <item name="android:padding">0dp</item>
    </style>
</resources>

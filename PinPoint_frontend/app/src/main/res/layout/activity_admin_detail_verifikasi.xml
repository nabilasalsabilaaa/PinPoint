<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF">

    <!-- Header Fixed -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBackDetailVerify"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_white_rounded_btn"
            android:padding="8dp"
            android:src="@drawable/back"
            app:tint="#0B1C30"
            android:elevation="1dp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail Verifikasi"
            android:textColor="#0B1C30"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutHeader"
        android:layout_above="@id/layoutActionButtons"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Utama Laporan -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/verif"
                                app:tint="#0B3C8C"
                                android:layout_marginEnd="6dp"/>
                            <TextView
                                android:id="@+id/tvReportIdCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ID #LP-MKS-2025-0842"
                                android:textColor="#434653"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvReportStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/bg_badge_green_light"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="● Menunggu Verifikasi"
                            android:textColor="#00897B"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvReportTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kerusakan Ruas Jalan Utama (Amblas &amp; Berlubang)"
                        android:textColor="#0B1C30"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginBottom="16dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:id="@+id/ivReportPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/sampul"
                                android:background="#E2E8F0" />
                        </androidx.cardview.widget.CardView>

                        <!-- Photo Metadata Overlay -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:background="#80000000"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="#FFFFFF"
                                android:layout_marginEnd="6dp"/>

                            <TextView
                                android:id="@+id/tvPhotoMetaInfo"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Kamera Smartphone • 14 Okt 2025 09:12"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Zoom"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:layout_marginEnd="4dp"/>

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@android:drawable/ic_menu_crop"
                                app:tint="#FFFFFF"/>
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Section Deskripsi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="#0B3C8C"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deskripsi dari Warga:"
                            android:textColor="#434653"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCitizenDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_blue_light"
                        android:padding="12dp"
                        android:text="Aspal amblas sedalam 15 cm di lajur tengah arah Flyover Urip. Sangat berbahaya bagi pengendara motor terutama saat malam hari atau hujan karena genangan air menutupi lubang."
                        android:textColor="#0B1C30"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: GPS Validation -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/location"
                            app:tint="#0B3C8C"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Validasi Titik GPS"
                            android:textColor="#0B1C30"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Map Placeholder -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginBottom="12dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">
                            <FrameLayout
                                android:id="@+id/mapContainer"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#E2E8F0">
                                <!-- Peta akan dikerjakan di sini -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="Area Peta (Map Integration)"
                                    android:textColor="#64748B"
                                    android:textSize="12sp"/>
                            </FrameLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Coordinate Badge -->
                        <TextView
                            android:id="@+id/tvGpsCoordinatesBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_white_rounded_btn"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="-5.1523, 119.4382"
                            android:textColor="#0B1C30"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:elevation="2dp"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvReportAddressTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Jl. A.P. Pettarani No. 42 (Lajur Tengah)"
                                android:textColor="#0B1C30"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Kec. Rappocini, Kota Makassar, Sulawesi Selatan"
                                android:textColor="#64748B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Identitas Pelapor -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/user"
                            app:tint="#0B3C8C"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Identitas Pelapor"
                            android:textColor="#0B1C30"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_blue_light"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nama Warga"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvReporterNameValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Andi Muhammad"
                            android:textColor="#0B1C30"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginBottom="8dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D1D5DB"
                            android:layout_marginBottom="8dp"/>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/call"
                                    app:tint="#434653"
                                    android:layout_marginEnd="8dp"/>
                                <TextView
                                    android:id="@+id/tvReporterPhone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0812-4211-****"
                                    android:textColor="#0B1C30"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="WhatsApp Aktif"
                                android:textColor="#434653"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Buttons Fixed -->
    <LinearLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="12dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnApproveReport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_chip_blue_active"
            android:text="Terima &amp; Teruskan ke Dinas"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRejectReport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_white_rounded_btn"
            android:text="Tolak Laporan Ini"
            android:textAllCaps="false"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:textSize="14sp"
            android:elevation="0dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 1. Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/btnBackEditCategory"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_white_rounded_btn"
                    android:padding="8dp"
                    android:src="@drawable/back"
                    app:tint="#0B1C30"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit Kategori"
                    android:textColor="#0B1C30"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E8F1FF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/tvCategoryStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_green_light"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Aktif"
                            android:textColor="#00897B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCategoryCodeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/tvCategoryStatusBadge"
                            android:layout_marginStart="8dp"
                            android:background="#D0E2FF"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="# KTG-MKS"
                            android:textColor="#0B3C8C"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvConnectedReportsBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="0 Laporan Terhubung"
                            android:textColor="#0B3C8C"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivHeaderCategoryIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circle_blue_btn"
                            android:padding="10dp"
                            android:src="@android:drawable/ic_menu_manage"
                            app:tint="#FFFFFF"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/tvHeaderCategoryTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nama Kategori"
                            android:textColor="#0B1C30"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Form Edit -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kode Referensi"
                android:textColor="#0B1C30"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etTaxonomyCode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip_blue_light"
                android:enabled="false"
                android:paddingHorizontal="14dp"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Kategori Publik"
                android:textColor="#0B1C30"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etEditCategoryName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/kolom_form"
                android:paddingHorizontal="14dp"
                android:textColor="#0B1C30"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <!-- 4. Grid Ikon -->
            <TextView
                android:id="@+id/tvSelectedIconLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Ikon Baru"
                android:textColor="#0B1C30"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="2"
                android:layout_marginBottom="20dp">

                <LinearLayout android:id="@+id/llEditIconJalan" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_chip_white" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/jalan" app:tint="#434653" />
                </LinearLayout>

                <LinearLayout android:id="@+id/llEditIconLampu" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_chip_white" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lamp" app:tint="#434653" />
                </LinearLayout>

                <LinearLayout android:id="@+id/llEditIconAir" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_chip_white" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/drainage" app:tint="#434653" />
                </LinearLayout>

                <LinearLayout android:id="@+id/llEditIconTaman" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_chip_white" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/park" app:tint="#434653" />
                </LinearLayout>

                <LinearLayout android:id="@+id/llEditIconSampah" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_chip_white" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/delete" app:tint="#434653" />
                </LinearLayout>

                <LinearLayout android:id="@+id/llEditIconTrotoar" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_chip_white" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/walk" app:tint="#434653" />
                </LinearLayout>

                <LinearLayout android:id="@+id/llEditIconJembatan" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_chip_white" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/bridge" app:tint="#434653" />
                </LinearLayout>

                <LinearLayout android:id="@+id/llEditIconHalte" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_chip_white" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/bus_stop" app:tint="#434653" />
                </LinearLayout>
            </GridLayout>

            <!-- Bagian Deskripsi dengan tvCharCounter -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deskripsi"
                    android:textColor="#0B1C30"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true" />

                <TextView
                    android:id="@+id/tvCharCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="0/250"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </RelativeLayout>

            <EditText
                android:id="@+id/etEditCategoryDesc"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/kolom_form"
                android:gravity="top|start"
                android:padding="12dp"
                android:textColor="#0B1C30"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status Kategori Aktif"
                    android:textColor="#0B1C30"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchCategoryActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <Button
                android:id="@+id/btnUpdateCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Simpan Perubahan"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#0B3C8C"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>

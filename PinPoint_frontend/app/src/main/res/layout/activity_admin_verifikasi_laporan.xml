<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FC">

    <!-- Bottom Nav -->
    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/layout_admin_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_alignParentBottom="true" />

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:background="#F6F8FC">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verifikasi Laporan"
            android:textColor="#0B1C30"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etSearchReport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/kolom_form"
            android:hint="Cari ID Laporan atau Pelapor..."
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:paddingHorizontal="14dp"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:id="@+id/llVerifCategoryChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/chipPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_blue_active"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="Menunggu"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />
                <TextView
                    android:id="@+id/chipJalanRusak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_white"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="Jalan Rusak"
                    android:textColor="#434653"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />
                <TextView
                    android:id="@+id/chipLampuPju"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_white"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="Lampu PJU"
                    android:textColor="#434653"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Empty State -->
    <include
        android:id="@+id/layoutEmptyState"
        layout="@layout/item_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- Scrollable List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVerifReports"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerContainer"
        android:layout_above="@id/bottomNavContainer"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:scrollbars="vertical" />

</RelativeLayout>

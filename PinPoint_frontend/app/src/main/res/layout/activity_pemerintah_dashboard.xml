<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp">

            <!-- 1. Header Salam -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Halo, "
                    android:textColor="#0B1C30"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOfficerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Petugas"
                    android:textColor="#0B3C8C"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Ringkasan Status Metric Cards (Horizontal Scroll) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Card 1: Perlu Aksi -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="120dp"
                        android:layout_height="125dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF"
                        android:layout_marginEnd="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Perlu Aksi"
                                    android:textColor="#434653"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_alignParentEnd="true"
                                    android:background="@drawable/bg_badge_blue_light"
                                    android:gravity="center"
                                    android:text="!"
                                    android:textColor="#0B3C8C"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvStatPerluAksi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="0"
                                android:textColor="#0B1C30"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Tugas Aktif"
                                android:textColor="#737784"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card 2: Terverifikasi -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="120dp"
                        android:layout_height="125dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF"
                        android:layout_marginEnd="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Terverifikasi"
                                android:textColor="#434653"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvStatVerified"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="0"
                                android:textColor="#0B3C8C"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Siap Eksekusi"
                                android:textColor="#737784"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card 3: Sedang Diproses -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="120dp"
                        android:layout_height="125dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF"
                        android:layout_marginEnd="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Diproses"
                                android:textColor="#434653"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvStatInProgress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="0"
                                android:textColor="#613EEA"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Di Lapangan"
                                android:textColor="#737784"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card 4: Selesai -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="120dp"
                        android:layout_height="125dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Selesai"
                                android:textColor="#434653"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvStatCompleted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="0"
                                android:textColor="#00A389"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Laporan Tuntas"
                                android:textColor="#737784"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- 3. Filter Section Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TUGAS DISPOSISI &amp; LAPORAN MASUK"
                android:textColor="#737784"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp" />

            <!-- 4. Filter Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip 1: Semua -->
                    <TextView
                        android:id="@+id/chipFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="Semua Tugas (0)"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <!-- Chip 2: Terverifikasi -->
                    <TextView
                        android:id="@+id/chipFilterVerified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="Terverifikasi (0)"
                        android:textColor="#434653"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <!-- Chip 3: Sedang Diproses -->
                    <TextView
                        android:id="@+id/chipFilterInProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="Sedang Diproses (0)"
                        android:textColor="#434653"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <!-- Chip 4: Selesai -->
                    <TextView
                        android:id="@+id/chipFilterCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="Selesai (0)"
                        android:textColor="#434653"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 4b. Peta Persebaran Tugas Pemerintah (Selaras dengan Dashboard User & Admin) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPemerintahDashboardMap"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#DBEAFE">

                    <com.example.pinpoint.user.MapTouchWrapperLayout
                        android:id="@+id/mapTouchWrapperPemerintahDashboard"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.fragment.app.FragmentContainerView
                            android:id="@+id/pemerintahDashboardMapFragment"
                            android:name="com.google.android.gms.maps.SupportMapFragment"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.example.pinpoint.user.MapTouchWrapperLayout>

                    <!-- Top Left Row: Lokasi Saat Ini + Filter Belum/Sudah Diperbaiki (Scroll Horizontal, Tidak Menutupi Quick Access) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/layoutQuickAccessGovMap"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="6dp"
                        android:scrollbars="none"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_white_rounded_btn"
                                android:elevation="3dp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="5dp"
                                android:layout_marginEnd="6dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/location"
                                    app:tint="#0B58CA"
                                    android:layout_marginEnd="4dp" />

                                <TextView
                                    android:id="@+id/tvGovDashboardMapLocationPill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Makassar &amp; Sekitarnya"
                                    android:textColor="#0B1C30"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:maxLines="1" />
                            </LinearLayout>

                            <!-- Filter Status Perbaikan (Di Samping Nama Kota) -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_white_rounded_btn"
                                android:elevation="3dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="2dp">

                                <TextView
                                    android:id="@+id/chipGovMapFilterAll"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_btn_rounded_blue"
                                    android:paddingHorizontal="7dp"
                                    android:paddingVertical="3dp"
                                    android:text="Semua"
                                    android:textColor="#FFFFFF"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/chipGovMapFilterUnresolved"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="7dp"
                                    android:paddingVertical="3dp"
                                    android:text="Belum Diperbaiki"
                                    android:textColor="#475569"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/chipGovMapFilterResolved"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="7dp"
                                    android:paddingVertical="3dp"
                                    android:text="Sudah Diperbaiki"
                                    android:textColor="#475569"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:clickable="true"
                                    android:focusable="true" />
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Floating Quick Access Controls (Atas ke Bawah: Pusatkan Lokasi, Zoom Out, Zoom In, Perluas Peta) -->
                    <LinearLayout
                        android:id="@+id/layoutQuickAccessGovMap"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_white_rounded_btn"
                        android:elevation="3dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/btnGovCenterLocation"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_my_location"
                                app:tint="#0B58CA" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0" />

                        <TextView
                            android:id="@+id/btnGovZoomOut"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="-"
                            android:textColor="#0B1C30"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0" />

                        <TextView
                            android:id="@+id/btnGovZoomIn"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#0B1C30"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0" />

                        <LinearLayout
                            android:id="@+id/btnExpandGovDashboardMap"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_fullscreen"
                                app:tint="#0B58CA" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Floating Info Popup Saat Pin Diklik -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardGovSelectedPinPopup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_above="@id/barExpandGovDashboardMap"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginBottom="2dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="#FFFFFF"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:layout_marginBottom="2dp">

                                    <ImageView
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:src="@drawable/location"
                                        app:tint="#0B58CA"
                                        android:layout_marginEnd="4dp" />

                                    <TextView
                                        android:id="@+id/tvGovPinPopupLocation"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Nama Daerah"
                                        android:textColor="#0B1C30"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:maxLines="1"
                                        android:ellipsize="end" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvGovPinPopupTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Judul Kerusakan"
                                    android:textColor="#64748B"
                                    android:textSize="11sp"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/btnGovPinPopupDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:background="@drawable/bg_btn_rounded_blue"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Lihat Detail"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Overlay Info Bar Peta (Bawah) dengan Tombol Perluas Peta -->
                    <LinearLayout
                        android:id="@+id/barExpandGovDashboardMap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_map_bottom_overlay"
                        android:elevation="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/location"
                            app:tint="#FFFFFF"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ketuk pin pada peta untuk info laporan"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvToggleExpandGovDashboardMap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Perluas Peta"
                            android:textColor="#2DD4BF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Legenda Warna Pin (Di Bawah Peta, Kecil & Ringkas) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tingkat Kerusakan: "
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:layout_marginEnd="6dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_badge_red_circle"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kritis"
                    android:textColor="#0B1C30"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_urgency_critical"
                    android:backgroundTint="#F59E0B"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sedang"
                    android:textColor="#0B1C30"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_badge_diproses_mint"
                    android:backgroundTint="#10B981"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rendah"
                    android:textColor="#0B1C30"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvEmptyPemerintahReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:gravity="center"
                android:padding="24dp"
                android:text="Belum ada tugas laporan pada status ini."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- 5. Daftar Laporan (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPemerintahReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_pemerintah_report_card"
                tools:itemCount="3" />

            <!-- 6. Callout Banner: Siaga Respon Cepat -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#0B3C8C"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/btnCallTeam"
                        android:layout_marginEnd="12dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_blue_btn"
                            android:backgroundTint="#1E4E9E"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_directions"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Siaga Respon Cepat"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Tim teknis siap ditugaskan ke lokasi laporan"
                                android:textColor="#90CAF9"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnCallTeam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_white_rounded_btn"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="9dp"
                        android:text="Panggil Tim"
                        android:textColor="#0B3C8C"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Floating Bottom Navigation (Selaras dengan Admin) -->
    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/layout_pemerintah_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>

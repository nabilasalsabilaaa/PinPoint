<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userBottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- 1. Background Bar Putih Melengkung (Floating Navbar) -->
    <View
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_navbar"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginBottom="12dp" />

    <!-- 2. Menu Beranda -->
    <LinearLayout
        android:id="@+id/navUserHome"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/navUserHistory"
        app:layout_constraintHorizontal_weight="1"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/ivNavUserHome"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:paddingHorizontal="11dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_nav_icon_active_blue"
            android:src="@drawable/home"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvNavUserHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Beranda"
            android:textColor="#0B58CA"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Menu Riwayat -->
    <LinearLayout
        android:id="@+id/navUserHistory"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/navUserHome"
        app:layout_constraintRight_toLeftOf="@id/guidelineCenter"
        app:layout_constraintHorizontal_weight="1"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="28dp">

        <ImageView
            android:id="@+id/ivNavUserHistory"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:paddingHorizontal="11dp"
            android:paddingVertical="4dp"
            android:src="@drawable/ic_history"
            app:tint="#94A3B8" />

        <TextView
            android:id="@+id/tvNavUserHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Riwayat"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Garis Tengah Panduan -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- 4. Menu Notifikasi -->
    <LinearLayout
        android:id="@+id/navUserNotification"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/guidelineCenter"
        app:layout_constraintRight_toLeftOf="@id/navUserProfile"
        app:layout_constraintHorizontal_weight="1"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="28dp">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="30dp">

            <ImageView
                android:id="@+id/ivNavUserNotification"
                android:layout_width="44dp"
                android:layout_height="30dp"
                android:paddingHorizontal="11dp"
                android:paddingVertical="4dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bell"
                app:tint="#94A3B8" />

            <!-- Badge Notifikasi Merah di Pojok Kanan Atas Lonceng -->
            <TextView
                android:id="@+id/tvNavBadgeCount"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_red_circle"
                android:gravity="center"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNavUserNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Notifikasi"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 5. Menu Profil -->
    <LinearLayout
        android:id="@+id/navUserProfile"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/navUserNotification"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintHorizontal_weight="1"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/ivNavUserProfile"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:paddingHorizontal="11dp"
            android:paddingVertical="4dp"
            android:src="@drawable/user"
            app:tint="#94A3B8" />

        <TextView
            android:id="@+id/tvNavUserProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Profil"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 6. Tombol Tengah Menonjol: (+) Lapor -->
    <LinearLayout
        android:id="@+id/navUserReportCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:elevation="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="22dp">

        <LinearLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_circle_blue_btn"
            android:elevation="4dp"
            android:gravity="center">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_add"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Lapor"
            android:textColor="@color/primary_blue"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

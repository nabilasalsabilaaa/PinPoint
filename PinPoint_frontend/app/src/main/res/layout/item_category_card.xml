<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Baris Atas: Ikon, Judul, & Badge Status Aktif -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivCategoryIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_blue_light"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#0B3C8C"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvCategoryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/ivCategoryIcon"
                android:layout_toStartOf="@id/tvCategoryStatusBadge"
                android:layout_centerVertical="true"
                android:text="Jalan &amp; Jembatan Rusak"
                android:textColor="#0B1C30"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCategoryStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_green_light"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="● Aktif"
                android:textColor="#00897B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Deskripsi Kategori -->
        <TextView
            android:id="@+id/tvCategoryDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lubang jalan, aspal retak, trotoar rusak, pembatas jalan ambruk."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Kotak Beban Berjalan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_blue_light"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Beban Berjalan:"
                android:textColor="#0B1C30"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCategoryActiveLoad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 laporan"
                android:textColor="#0B3C8C"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Baris Bawah: ID Kategori & Aksi (Edit / Hapus) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvCategoryIdCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="ID: KTG-MKS-01"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnEditCategory"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_blue_light"
                    android:padding="6dp"
                    android:src="@drawable/edit"
                    app:tint="#0B1C30"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/btnDeleteCategory"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_red_light"
                    android:padding="6dp"
                    android:src="@drawable/delete"
                    app:tint="#D32F2F" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>

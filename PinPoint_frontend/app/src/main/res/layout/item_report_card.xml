<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvReportStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_red_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="● MENUNGGU VERIFIKASI"
                android:textColor="#D32F2F"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="10 mnt lalu"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivReportThumbnail"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="#E2E8F0"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReportTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Judul Kerusakan Fasilitas"
                    android:textColor="#0B1C30"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="4dp" />

                <!-- Baris Pelapor -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/user"
                        android:layout_marginEnd="6dp"
                        app:tint="#64748B" />

                    <TextView
                        android:id="@+id/tvReportUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pelapor: -"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
                <!-- Baris Lokasi -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/location"
                        android:layout_marginEnd="6dp"
                        app:tint="#64748B" />

                    <TextView
                        android:id="@+id/tvReportLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alamat Lokasi"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickReject"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="✕ Tolak"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:backgroundTint="#FFEBEE"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnQuickApprove"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.4"
                android:text="✓ Validasi Cepat"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#0B3C8C" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
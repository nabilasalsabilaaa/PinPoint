<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Scrollable Content Area -->
    <ScrollView
        android:id="@+id/scrollViewDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <!-- 1. Header Salam & Nama Pengguna -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Halo, "
                    android:textColor="#0B1C30"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengguna"
                    android:textColor="#0B58CA"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Badge Portal Warga Aktif (Sinkron Titik Lokasi User yang Login) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EEF4FF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/verif"
                        app:tint="#0B58CA"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Portal Warga Aktif"
                            android:textColor="#0B1C30"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPortalLocationSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mendeteksi titik lokasi Anda saat ini..."
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Search Bar (Tanpa Icon Filter) & Tombol Notifikasi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- Input Pencarian -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        app:tint="#64748B" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Cari lokasi jalan, lampu, drainase..."
                        android:textColor="#0B1C30"
                        android:textColorHint="#94A3B8"
                        android:textSize="12sp"
                        android:paddingHorizontal="10dp"
                        android:imeOptions="actionSearch"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- Tombol Bel Notifikasi Atas (Dot Merah di Pojok Kanan Atas Ikon) -->
                <FrameLayout
                    android:id="@+id/btnTopNotif"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_search_bar"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell"
                        app:tint="#0B1C30" />

                    <TextView
                        android:id="@+id/tvTopBadgeCount"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="7dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_badge_red_circle"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- 4. Filter Kategori Dinamis dari Database -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/llUserCategoryChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_blue_active"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="9dp"
                        android:text="Semua"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 5. Interactive Map Preview Card (Dengan Fitur Expand Peta & Anti-Intercept Scroll) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDashboardMap"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#DBEAFE">

                    <com.example.pinpoint.user.MapTouchWrapperLayout
                        android:id="@+id/mapTouchWrapperDashboard"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.google.android.gms.maps.MapView
                            android:id="@+id/googleDashboardMapView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.example.pinpoint.user.MapTouchWrapperLayout>

                    <!-- Top Left Row: Lokasi Saat Ini + Filter Belum/Sudah Diperbaiki (Scroll Horizontal, Tidak Menutupi Quick Access) -->
                    <HorizontalScrollView
                        android:id="@+id/layoutTopMapPills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/layoutQuickAccessUserMap"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="6dp"
                        android:scrollbars="none"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_white_rounded_btn"
                                android:elevation="3dp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="5dp"
                                android:layout_marginEnd="6dp">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/location"
                                    app:tint="#0B58CA"
                                    android:layout_marginEnd="4dp" />

                                <TextView
                                    android:id="@+id/tvDashboardMapLocationPill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Makassar &amp; Sekitarnya"
                                    android:textColor="#0B1C30"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:maxLines="1" />
                            </LinearLayout>

                            <!-- Filter Status Perbaikan (Di Samping Nama Kota) -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_white_rounded_btn"
                                android:elevation="3dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="2dp">

                                <TextView
                                    android:id="@+id/chipMapFilterAll"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_btn_rounded_blue"
                                    android:paddingHorizontal="7dp"
                                    android:paddingVertical="3dp"
                                    android:text="Semua"
                                    android:textColor="#FFFFFF"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/chipMapFilterUnresolved"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="7dp"
                                    android:paddingVertical="3dp"
                                    android:text="Belum Diperbaiki"
                                    android:textColor="#475569"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/chipMapFilterResolved"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="7dp"
                                    android:paddingVertical="3dp"
                                    android:text="Sudah Diperbaiki"
                                    android:textColor="#475569"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:clickable="true"
                                    android:focusable="true" />
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Floating Quick Access Controls (Atas ke Bawah: Pusatkan Lokasi, Zoom Out, Zoom In, Perluas Peta) -->
                    <LinearLayout
                        android:id="@+id/layoutQuickAccessUserMap"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_white_rounded_btn"
                        android:elevation="3dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/btnCenterLocation"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_my_location"
                                app:tint="#0B58CA" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0" />

                        <TextView
                            android:id="@+id/btnZoomOut"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="-"
                            android:textColor="#0B1C30"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0" />

                        <TextView
                            android:id="@+id/btnZoomIn"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#0B1C30"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E2E8F0" />

                        <LinearLayout
                            android:id="@+id/btnExpandDashboardMap"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_fullscreen"
                                app:tint="#0B58CA" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Floating Info Popup Saat Pin Diklik (Menampilkan Nama Daerah & Tombol Kecil Lihat Detail) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardSelectedPinPopup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_above="@id/barExpandDashboardMap"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginBottom="2dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="#FFFFFF"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:layout_marginBottom="2dp">

                                    <ImageView
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:src="@drawable/location"
                                        app:tint="#0B58CA"
                                        android:layout_marginEnd="4dp" />

                                    <TextView
                                        android:id="@+id/tvPinPopupLocation"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Nama Daerah"
                                        android:textColor="#0B1C30"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:maxLines="1"
                                        android:ellipsize="end" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvPinPopupTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Judul Kerusakan"
                                    android:textColor="#64748B"
                                    android:textSize="11sp"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/btnPinPopupDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:background="@drawable/bg_btn_rounded_blue"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Lihat Detail"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Overlay Info Bar Peta (Bawah) dengan Tombol Perluas Peta -->
                    <LinearLayout
                        android:id="@+id/barExpandDashboardMap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_map_bottom_overlay"
                        android:elevation="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/location"
                            app:tint="#FFFFFF"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ketuk pin pada peta untuk info laporan"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvToggleExpandMap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Perluas Peta"
                            android:textColor="#2DD4BF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Legenda Warna Pin (Di Bawah Peta, Kecil & Ringkas) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tingkat Kerusakan: "
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:layout_marginEnd="6dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_badge_red_circle"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kritis"
                    android:textColor="#0B1C30"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_urgency_critical"
                    android:backgroundTint="#F59E0B"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sedang"
                    android:textColor="#0B1C30"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_badge_diproses_mint"
                    android:backgroundTint="#10B981"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rendah"
                    android:textColor="#0B1C30"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 6. Banner Temukan Kerusakan di Sekitar? -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/primary_blue"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_chip_blue_light"
                            android:gravity="center"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_alert_triangle"
                                app:tint="@color/primary_blue" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Temukan Kerusakan di Sekitar?"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Unggah foto &amp; koordinat untuk respon cepat satgas."
                                android:textColor="#BFDBFE"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Tombol Mint: Buat Laporan Cepat dengan Icon Tambah yang Lebih Baik -->
                    <LinearLayout
                        android:id="@+id/btnQuickReport"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_btn_cta_mint"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_add"
                            app:tint="#0F172A"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buat Laporan Cepat"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 7. Header Daftar Laporan Masuk (Urut Berdasarkan Dukungan Terbanyak) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Laporan Warga Terkini"
                    android:textColor="#0B1C30"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Terpopuler Didukung"
                    android:textColor="#0B58CA"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvEmptyUserDashboardReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:gravity="center"
                android:padding="24dp"
                android:text="Belum ada laporan yang sesuai dengan pencarian."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- RecyclerView Seluruh Laporan Warga -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUserDashboardReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_user_report_card" />

        </LinearLayout>
    </ScrollView>

    <!-- Floating Bottom Navigation Bar -->
    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/layout_user_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil Akun"
                android:textColor="#0B1C30"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- 1. Kartu Header Profil Utama Minimalis -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <!-- Avatar Foto dengan Tombol Edit -->
                    <RelativeLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginBottom="12dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="44dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/ivProfilePicture"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/user"
                                android:padding="20dp"
                                android:background="#E8F1FF" />
                        </androidx.cardview.widget.CardView>

                        <ImageView
                            android:id="@+id/btnEditPhoto"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/bg_circle_blue_btn"
                            android:padding="6dp"
                            android:src="@android:drawable/ic_menu_edit"
                            android:clickable="true"
                            android:focusable="true"
                            app:tint="#FFFFFF" />
                    </RelativeLayout>

                    <!-- Nama Lengkap Admin -->
                    <TextView
                        android:id="@+id/tvAdminName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Admin"
                        android:textColor="#0B1C30"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="2dp" />

                    <!-- Email Admin -->
                    <TextView
                        android:id="@+id/tvAdminEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="admin@pinpoint.id"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvAdminRoleBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_blue_light"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="ADMINISTRATOR"
                        android:textColor="#0B3C8C"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. Kartu Kelompok Menu Minimalis (Tanpa Notifikasi) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Menu 1: Biodata Diri -->
                    <RelativeLayout
                        android:id="@+id/btnMenuBiodata"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:paddingHorizontal="16dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivIconBiodata"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_chip_blue_light"
                            android:padding="9dp"
                            android:src="@drawable/user"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="14dp"
                            app:tint="#0B3C8C" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivIconBiodata"
                            android:layout_centerVertical="true"
                            android:text="Biodata Diri"
                            android:textColor="#0B1C30"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginStart="66dp" />

                    <!-- Menu 2: Keamanan Akun -->
                    <RelativeLayout
                        android:id="@+id/btnMenuSecurity"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:paddingHorizontal="16dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivIconSecurity"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_chip_blue_light"
                            android:padding="9dp"
                            android:src="@drawable/ic_shield_check"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="14dp"
                            app:tint="#0B3C8C" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivIconSecurity"
                            android:layout_centerVertical="true"
                            android:text="Keamanan Akun"
                            android:textColor="#0B1C30"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginStart="66dp" />

                    <!-- Menu 3: Bantuan & FAQ -->
                    <RelativeLayout
                        android:id="@+id/btnMenuHelp"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:paddingHorizontal="16dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivIconHelp"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_chip_blue_light"
                            android:padding="9dp"
                            android:src="@android:drawable/ic_menu_help"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="14dp"
                            app:tint="#0B3C8C" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivIconHelp"
                            android:layout_centerVertical="true"
                            android:text="Pusat Bantuan &amp; FAQ"
                            android:textColor="#0B1C30"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginStart="66dp" />

                    <!-- Menu 4: Tentang -->
                    <RelativeLayout
                        android:id="@+id/btnMenuAbout"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:paddingHorizontal="16dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivIconAbout"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_chip_blue_light"
                            android:padding="9dp"
                            android:src="@android:drawable/ic_menu_info_details"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="14dp"
                            app:tint="#0B3C8C" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivIconAbout"
                            android:layout_centerVertical="true"
                            android:text="Tentang Aplikasi"
                            android:textColor="#0B1C30"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Tombol Logout -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#FFEBEE"
                android:text="Keluar dari Akun"
                android:textAllCaps="false"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/layout_admin_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>

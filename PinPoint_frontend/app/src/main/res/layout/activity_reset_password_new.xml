<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Tombol Back Standar 36dp x 36dp -->
        <ImageView
            android:id="@+id/btnBackResetNew"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_white_rounded_btn"
            android:padding="8dp"
            android:src="@drawable/back"
            app:tint="#0B1C30"
            android:layout_marginBottom="24dp" />

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buat Kata Sandi Baru"
            android:textColor="#0B1C30"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvResetEmailInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verifikasi OTP berhasil! Silakan masukkan kata sandi baru untuk akun Anda."
            android:textColor="#475569"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="24dp" />

        <!-- Card Input Kata Sandi Baru -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Kata Sandi Baru -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kata Sandi Baru *"
                    android:textColor="#0B1C30"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/kolom_form"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etNewResetPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@id/ivToggleNewResetPass"
                        android:background="@android:color/transparent"
                        android:hint="Minimal 6 karakter"
                        android:inputType="textPassword"
                        android:paddingHorizontal="16dp"
                        android:textColor="#0B1C30"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/ivToggleNewResetPass"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:padding="10dp"
                        android:src="@drawable/mata"
                        app:tint="#64748B" />
                </RelativeLayout>

                <!-- Konfirmasi Kata Sandi Baru -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Konfirmasi Kata Sandi Baru *"
                    android:textColor="#0B1C30"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/kolom_form">

                    <EditText
                        android:id="@+id/etConfirmResetPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@id/ivResetMatchIcon"
                        android:background="@android:color/transparent"
                        android:hint="Ulangi kata sandi baru"
                        android:inputType="textPassword"
                        android:paddingHorizontal="16dp"
                        android:textColor="#0B1C30"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/ivResetMatchIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_toStartOf="@id/ivToggleConfirmResetPass"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivToggleConfirmResetPass"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:padding="10dp"
                        android:src="@drawable/mata"
                        app:tint="#64748B" />
                </RelativeLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tombol Simpan Kata Sandi Baru -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveNewResetPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_chip_blue_active"
            android:text="Simpan Kata Sandi Baru"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>


<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF">

    <fragment
        android:id="@+id/pemerintahMapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer" />

    <!-- Top Overlay: Search Bar & Action Buttons (Tetap pada tempatnya) -->
    <LinearLayout
        android:id="@+id/topMapOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_bar"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="#64748B"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/etSearchMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Cari laporan, jalan, atau kategori..."
                    android:textColor="#0B1C30"
                    android:textColorHint="#94A3B8"
                    android:textSize="13sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- GPS Button (Tetap pada tempatnya) -->
            <FrameLayout
                android:id="@+id/btnGps"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_white_card"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="#0B3C8C" />
            </FrameLayout>

            <!-- Layer/Satelit Button (Tetap pada tempatnya) -->
            <FrameLayout
                android:id="@+id/btnLayer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_white_card"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_mapmode"
                    app:tint="#0B3C8C" />
            </FrameLayout>
        </LinearLayout>

        <!-- Dynamic Filter Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/llMapCategoryChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipMapAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:elevation="4dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Semua (0)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Floating Quick Access Zoom Controls (Atas ke Bawah: Zoom Out, Zoom In) -->
    <LinearLayout
        android:id="@+id/layoutMapZoomControls"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/topMapOverlay"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_white_rounded_btn"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnMapZoomOut"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="-"
            android:textColor="#0B1C30"
            android:textSize="18sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />

        <TextView
            android:id="@+id/btnMapZoomIn"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#0B1C30"
            android:textSize="18sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ================= TAMPILAN 1: LIST VERTIKAL LAPORAN (DEFAULT - SEPERTI REFERENSI GAMBAR 3) ================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMapListContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_above="@id/bottomNavContainer"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_drag_handle"
                android:layout_marginBottom="8dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daftar Titik Laporan"
                    android:textColor="#0B1C30"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMapListTotalCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Ketuk laporan untuk lihat titik"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvEmptyMapReportList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Belum ada laporan yang sesuai pencarian."
                android:textColor="#64748B"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMapReportList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                tools:listitem="@layout/item_pemerintah_map_list_row" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ================= TAMPILAN 2: FLOATING CARD CAROUSEL (SWIPE KE SAMPING - SEPERTI REFERENSI GAMBAR 1 & 2) ================= -->
    <LinearLayout
        android:id="@+id/layoutFloatingCarouselContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNavContainer"
        android:layout_marginBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- ViewPager2 Horizontal dengan Peek Kiri-Kanan -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpMapFloatingCards"
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp" />

        <!-- Tombol Bulat X untuk Menutup Floating Card & Kembali ke List Vertikal -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnCloseFloatingCarousel"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="19dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✕"
                android:textColor="#0B1C30"
                android:textSize="15sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Floating Bottom Navigation (Selaras dengan Admin) -->
    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/layout_pemerintah_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>

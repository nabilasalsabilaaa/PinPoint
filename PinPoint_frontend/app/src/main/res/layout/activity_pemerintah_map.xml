<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- OSMDroid MapView as Background -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer" />

    <!-- Top Overlay: Search Bar & Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <!-- Search & Control Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_bar"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#737784"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/etSearchMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Cari lokasi, jalan di Makassar..."
                    android:textColor="#0B1C30"
                    android:textColorHint="#94A3B8"
                    android:textSize="13sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- GPS Button -->
            <FrameLayout
                android:id="@+id/btnGps"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_white_card"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="#003C90" />
            </FrameLayout>

            <!-- Layer/Filter Map Button -->
            <FrameLayout
                android:id="@+id/btnLayer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_white_card"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_mapmode"
                    app:tint="#003C90" />
            </FrameLayout>
        </LinearLayout>

        <!-- Filter Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Chip 1: Semua (28) -->
                <TextView
                    android:id="@+id/chipMapAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:elevation="4dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="☰ Semua (28)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <!-- Chip 2: Jalan (18) -->
                <TextView
                    android:id="@+id/chipMapJalan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_white"
                    android:elevation="4dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="● Jalan (18)"
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <!-- Chip 3: Penerangan (4) -->
                <TextView
                    android:id="@+id/chipMapPenerangan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_white"
                    android:elevation="4dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="● Penerangan (4)"
                    android:textColor="#003C90"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Bottom Selected Report Card Overlay (Above Bottom Nav) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardReportDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNavContainer"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_drag_handle"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMapReportId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#LP-MKS-0840"
                        android:textColor="#003C90"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  •  "
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvMapReportPriority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_red_light"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="● PRIORITAS TINGGI"
                        android:textColor="#D32F2F"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMapReportStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge_blue_light"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="● Terverifikasi"
                    android:textColor="#003C90"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvMapReportTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jalan Berlubang Parah di Lajur Cepat..."
                android:textColor="#0B1C30"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_callout_blue"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="#E2E8F0"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:id="@+id/ivMapReportThumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:background="#88000000"
                        android:paddingHorizontal="4dp"
                        android:text="Foto"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMapReportLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 Jl. A.P. Pettarani No. 102, Rappocini"
                        android:textColor="#0B1C30"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvMapReportDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kedalaman lubang ±15cm, mengancam keselamatan pengendara motor jalur..."
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMapReportDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↗ 0.8 km dari posko"
                            android:textColor="#003C90"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/tvMapReportTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏱ 45 mnt lalu"
                            android:textColor="#737784"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnRouteGuidance"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_directions"
                        app:tint="#003C90"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pandu Rute"
                        android:textColor="#003C90"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnReportDetail"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detail Laporan &gt;"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Floating Bottom Navigation -->
    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/layout_pemerintah_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>

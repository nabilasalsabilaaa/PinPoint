<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layout_marginBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Baris Kategori, Status Tag, & Tanggal -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCardCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_blue_light"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Kategori"
                    android:textColor="#0B58CA"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvCardStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_green_light"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Menunggu Verifikasi"
                    android:textColor="#059669"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_time"
                    app:tint="#64748B"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvCardDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Foto Thumbnail & Informasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <!-- Thumbnail Foto Laporan (Ketuk untuk pop up slide foto) -->
            <RelativeLayout
                android:id="@+id/layoutCardPhoto"
                android:layout_width="92dp"
                android:layout_height="86dp"
                android:layout_marginEnd="14dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivCardReportPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#E2E8F0"
                    android:src="@drawable/sampul" />

                <!-- Badge Jumlah Foto -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="4dp"
                    android:background="#99000000"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_camera"
                        app:tint="#FFFFFF"
                        android:layout_marginEnd="3dp" />

                    <TextView
                        android:id="@+id/tvCardPhotoCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Judul Laporan"
                    android:textColor="#0B1C30"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/location"
                        app:tint="#64748B"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tvCardLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lokasi Laporan"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Social Proof (Dukungan & Pelapor) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivCardThumbBadge"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_thumb_up"
                        app:tint="#0B58CA"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tvCardSupportCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Warga Mendukung"
                        android:textColor="#0B58CA"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Tombol Aksi Bawah Card (Tanpa Emoji & Tanpa Panah) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Tombol Dukung dengan Icon Template Thumb -->
            <LinearLayout
                android:id="@+id/btnCardSupport"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_rounded_blue_soft"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="10dp"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/ivBtnSupportThumb"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_thumb_up"
                    app:tint="#0B58CA"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvBtnSupportText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dukung"
                    android:textColor="#0B58CA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tombol Lihat Detail Laporan Tanpa Panah -->
            <LinearLayout
                android:id="@+id/btnCardViewDetail"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.5"
                android:background="@drawable/bg_btn_rounded_blue"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lihat Detail Laporan"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/svSignUp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/llMainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8F9FF"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="64dp"
            android:paddingBottom="32dp">

            <!-- Header Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign Up"
                    android:textColor="#0B1C30"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="241dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Daftarkan akun anda terlebih dahulu untuk \nbergabung bersama kami."
                    android:textColor="#434653"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Main Form Container -->
            <LinearLayout
                android:id="@+id/llFormContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape1"
                android:elevation="20dp"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Full Name Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvLabelFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nama Lengkap *"
                        android:textColor="#0B1C30"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/kolom_form"
                        android:hint="Masukkan nama lengkap anda"
                        android:inputType="textPersonName"
                        android:padding="11dp"
                        android:textColor="#737784"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Email Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvLabelEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alamat Email Aktif *"
                        android:textColor="#0B1C30"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/kolom_form"
                        android:hint="contohemail@gmail.com"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="11dp"
                        android:textColor="#737784"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tanggapan penanganan dan notifikasi otp akan dikirim melalui email ini"
                        android:textColor="#434653"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Phone Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvLabelPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nomor WhatsApp / Ponsel *"
                        android:textColor="#0B1C30"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/kolom_form"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <LinearLayout
                            android:id="@+id/llCountryCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/num_form"
                            android:layout_marginStart="13dp"
                            android:layout_marginEnd="14dp"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="3dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+62"
                                android:textColor="#0B1C30"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="812 3456 7890"
                            android:inputType="phone"
                            android:textColor="#737784"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Password Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvLabelPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kata Sandi *"
                        android:textColor="#0B1C30"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/kolom_form"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="13dp">

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Masukkan kata sandi anda"
                            android:inputType="textPassword"
                            android:paddingVertical="11dp"
                            android:textColor="#737784"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivPasswordVisibility"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/mata"
                            android:scaleType="centerInside" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Confirm Password Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvLabelConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Konfirmasi Kata Sandi *"
                        android:textColor="#0B1C30"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/kolom_form"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="13dp">

                        <EditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Konfirmasi kata sandi anda"
                            android:inputType="textPassword"
                            android:paddingVertical="11dp"
                            android:textColor="#737784"
                            android:textSize="14sp" />

                        <!-- Indikator Status Cocok / Tidak (Centang Hijau / Silang Merah) -->
                        <ImageView
                            android:id="@+id/ivPasswordMatchIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="8dp"
                            android:visibility="gone"
                            android:scaleType="centerInside" />

                        <!-- Ikon mata konfirmasi password -->
                        <ImageView
                            android:id="@+id/ivConfirmPasswordVisibility"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/mata"
                            android:scaleType="centerInside" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Terms and Conditions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_vertical">

                    <!-- Checkbox Aktif -->
                    <CheckBox
                        android:id="@+id/cbTerms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:background="@null" />

                    <!-- Teks dengan Syarat & Ketentuan / Kebijakan Privasi Warna Biru -->
                    <TextView
                        android:id="@+id/tvTermsConditions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saya menyetujui Syarat &amp; Ketentuan serta Kebijakan Privasi LaporFasum."
                        android:textColor="#434653"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <!-- Sign Up Button -->
                <LinearLayout
                    android:id="@+id/btnWrapperSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape3"
                    android:elevation="8dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign Up"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Login Link -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sudah punya akun?"
                        android:textColor="#434653"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:id="@+id/tvLoginLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Login here"
                        android:textColor="#003C90"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
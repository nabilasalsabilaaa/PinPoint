<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="44dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Reset Kata Sandi"
            android:textColor="#0B1C30"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="Masukkan alamat email atau nomor telepon akun Anda untuk menerima 6 digit kode OTP pemulihan."
            android:textColor="#475569"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="28dp" />

        <!-- Bar Geser Segmented (Email & WhatsApp) yang Rapi & Presisi -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E2E8F0">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                app:tabBackground="@android:color/transparent"
                app:tabIndicator="@drawable/bg_tab_pill_indicator"
                app:tabIndicatorColor="#0B3C8C"
                app:tabIndicatorGravity="stretch"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorAnimationMode="elastic"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabSelectedTextColor="#FFFFFF"
                app:tabTextColor="#475569"
                app:tabRippleColor="@null"
                app:tabIconTint="@color/tab_icon_selector"
                app:tabInlineLabel="true" />
        </androidx.cardview.widget.CardView>

        <!-- ViewPager2 untuk Konten Geser -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerForgotPassword"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="24dp" />

        <!-- Tombol Aksi Bawah -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:background="#F8F9FF">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmitForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Kirim Kode OTP (6 Digit)"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="@drawable/bg_chip_blue_active"
                android:elevation="2dp" />

            <LinearLayout
                android:id="@+id/btnBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="14dp"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kembali ke Halaman Login"
                    android:textColor="#0B3C8C"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainForm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. Header Toolbar Atas -->
    <LinearLayout
        android:id="@+id/toolbarForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBackForm"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_white_rounded_btn"
            android:padding="8dp"
            android:src="@drawable/back"
            app:tint="#0B1C30"
            android:elevation="1dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Kembali" />

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buat Laporan"
            android:textColor="#0B1C30"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Scrollable Body Form -->
    <ScrollView
        android:id="@+id/scrollViewForm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbarForm"
        android:layout_above="@id/bottomBarSubmit"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- ================= SECTION 1: UPLOAD FOTO (MULTI-PHOTO) ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/primary_blue"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unggah Foto Bukti Kerusakan"
                    android:textColor="#0B1C30"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashed_upload"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_chip_blue_light"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/primary_blue" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ambil Foto atau Pilih Beberapa dari Galeri"
                    android:textColor="#0B1C30"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bisa memilih lebih dari 1 foto bukti kerusakan"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnTakePhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_btn_rounded_blue"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_camera"
                            app:tint="#FFFFFF"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tambah Kamera"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnPickGallery"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_search_bar"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@android:drawable/ic_menu_upload"
                            app:tint="#0B1C30"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilih Galeri"
                            android:textColor="#0B1C30"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Preview Multi-Foto Setelah Dipilih -->
                <RelativeLayout
                    android:id="@+id/layoutSelectedPhotosContainer"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="14dp"
                    android:visibility="gone">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/ivSelectedPhotoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvSelectedPhotoCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true"
                        android:layout_margin="10dp"
                        android:background="#CC000000"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="1 Foto Terpilih • Ketuk untuk lihat slide"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnClearSelectedPhotos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_badge_ditolak"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Hapus Foto"
                        android:textColor="#B91C1C"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

            <!-- ================= SECTION 2: TITIK LOKASI ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/location"
                    app:tint="@color/primary_blue"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Titik Lokasi Fasilitas Umum"
                    android:textColor="#0B1C30"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMapPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="10dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.example.pinpoint.user.MapTouchWrapperLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.google.android.gms.maps.MapView
                            android:id="@+id/googleFormMapView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.example.pinpoint.user.MapTouchWrapperLayout>

                    <LinearLayout
                        android:id="@+id/btnLocateMe"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_white_rounded_btn"
                        android:elevation="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_my_location"
                            app:tint="#0B3C8C" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:elevation="6dp">

                        <TextView
                            android:id="@+id/tvPinAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_map_bottom_overlay"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Mendeteksi lokasi terkini..."
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:layout_marginBottom="2dp" />

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/location"
                            app:tint="#DC2626" />

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_badge_red_circle"
                            android:alpha="0.4"
                            android:layout_marginTop="-2dp" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_shield_card"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/location"
                    app:tint="@color/primary_blue"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Koordinat Titik Terkunci"
                        android:textColor="#0B1C30"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCoordinates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lat -5.1477 • Long 119.4327"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/location"
                    app:tint="@color/primary_blue" />
            </LinearLayout>

            <!-- Tombol Sesuaikan Pin Manual (Tanpa Emoji) -->
            <Button
                android:id="@+id/btnAdjustPinManual"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_manual_pin"
                app:backgroundTint="@null"
                android:text="Sesuaikan Pin Lokasi Manual"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- ================= SECTION 3: PILIH KATEGORI DARI DATABASE ================= -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/category"
                        app:tint="@color/primary_blue"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih Kategori Fasilitas"
                        android:textColor="#0B1C30"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Sesuai Database"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </RelativeLayout>

            <!-- Container Kategori Dinamis dari Database -->
            <LinearLayout
                android:id="@+id/llDynamicCategoryGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp" />

            <!-- ================= SECTION 4: DETAIL & TINGKAT BAHAYA ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_history"
                    app:tint="@color/primary_blue"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detail &amp; Tingkat Bahaya"
                    android:textColor="#0B1C30"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Judul Laporan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Judul Kerusakan / Laporan"
                android:textColor="#0B1C30"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etReportTitle"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_text_area"
                android:hint="Contoh: Jalan Berlubang di Depan Halte"
                android:textColor="#0B1C30"
                android:textColorHint="#94A3B8"
                android:textSize="13sp"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:layout_marginBottom="14dp" />

            <!-- Tingkat Bahaya / Urgensi Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tingkat Bahaya Kerusakan"
                android:textColor="#0B1C30"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <!-- Segmented Control Tingkat Bahaya (Rendah / Sedang / Kritis / Darurat) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_urgency_container"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/btnUrgencyLow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Rendah"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnUrgencyMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Sedang"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/btnUrgencyCritical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.4"
                    android:background="@drawable/bg_urgency_critical"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivUrgencyCriticalIcon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_alert_triangle"
                        app:tint="#FFFFFF"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tvUrgencyCriticalText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kritis / Darurat"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Label Deskripsi & Counter Karakter -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uraian Rinci Kejadian"
                    android:textColor="#0B1C30"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvCharCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="0/300 Karakter"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </RelativeLayout>

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/bg_text_area"
                android:gravity="top|start"
                android:hint="Tuliskan detail kondisi kerusakan, patokan lokasi, dan dampak bahaya..."
                android:textColor="#0B1C30"
                android:textColorHint="#94A3B8"
                android:textSize="12sp"
                android:padding="12dp"
                android:maxLength="300"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- 3. Bottom Bar: Kirim Laporan Fasilitas (Tanpa Emoji) -->
    <LinearLayout
        android:id="@+id/bottomBarSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="16dp">

        <Button
            android:id="@+id/btnSubmitReport"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_btn_rounded_blue"
            app:backgroundTint="@null"
            android:text="Kirim Laporan Fasilitas"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
